/* --- 图片消息 --- */
.msg-img {
  width: 100%;
  max-width: 560rpx;
  border-radius: 16rpx;
  display: block;
  margin-top: 8rpx;
}

.msg-file {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 300rpx;
  margin-top: 10rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 1rpx solid #e1e6e3;
}
.msg-file-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.msg-file-copy { min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.msg-file-name { font-size: 25rpx; color: #222222; overflow-wrap: anywhere; }
.msg-file-size { font-size: 21rpx; color: #888888; }
.attach-panel {
  flex-shrink: 0;
  padding: 28rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dedede;
  background: #f5f5f5;
  animation: attachPanelIn .18s ease-out;
}
.attach-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 8rpx;
  row-gap: 36rpx;
}
.attach-option {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.attach-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ededed;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.025);
}
.attach-option:active .attach-icon-wrap { background: #ececec; }
.attach-icon { width: 56rpx; height: 56rpx; }
.attach-label {
  width: 100%;
  min-height: 68rpx;
  color: #555555;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
  overflow-wrap: anywhere;
}
@keyframes attachPanelIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .attach-panel { animation: none; }
}
