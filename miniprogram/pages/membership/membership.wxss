.member-page { min-height: 100vh; padding: 48rpx 36rpx 80rpx; box-sizing: border-box; background: linear-gradient(180deg,#f1fbf4 0,#fff 420rpx); color: #253029; }
.member-hero { padding: 34rpx 10rpx 48rpx; }
.eyebrow,.hero-title,.hero-desc,.plan-name,.plan-note,.status-label,.status-title,.expire { display:block; }
.eyebrow { color:#068e48; font-size:20rpx; font-weight:700; letter-spacing:3rpx; }
.hero-title { margin-top:18rpx; font-size:48rpx; line-height:1.25; font-weight:750; }
.hero-desc { margin-top:20rpx; color:#69756e; font-size:25rpx; line-height:1.7; }
.state-card,.status-card,.plan-card { margin-bottom:24rpx; border:2rpx solid #e5ece7; border-radius:30rpx; background:#fff; box-shadow:0 12rpx 38rpx rgba(25,70,42,.06); }
.state-card { padding:70rpx 30rpx; text-align:center; color:#7e8982; }
.status-card { padding:38rpx; }
.status-card.active { border-color:#bfe8ca; }
.status-label { color:#7e8982; font-size:22rpx; }.status-title { margin-top:6rpx; font-size:38rpx; font-weight:700; }
.status-badge { float:right; margin-top:-68rpx; padding:8rpx 18rpx; border-radius:999rpx; background:#e8f8ed; color:#068e48; font-size:22rpx; }
.quota-line { display:flex; justify-content:space-between; margin-top:38rpx; color:#59665e; font-size:24rpx; }
.quota-track { height:14rpx; margin-top:16rpx; overflow:hidden; border-radius:999rpx; background:#edf1ee; }.quota-track view { height:100%; border-radius:999rpx; background:#07c160; }
.expire { margin-top:22rpx; color:#879088; font-size:22rpx; }
.plan-card { padding:36rpx; }.plan-card.selected { border-color:#07c160; box-shadow:0 14rpx 42rpx rgba(7,193,96,.1); }
.plan-head { display:flex; align-items:center; justify-content:space-between; }.plan-name { font-size:30rpx; font-weight:700; }.plan-note { margin-top:8rpx; color:#849087; font-size:22rpx; }
.price { color:#15271d; font-size:50rpx; font-weight:750; }.price text { margin-right:4rpx; font-size:24rpx; }
.benefit { display:flex; gap:16rpx; margin-top:25rpx; color:#506057; font-size:24rpx; }.benefit text:first-child { color:#07c160; font-weight:700; }
.agreement { margin:34rpx 8rpx 24rpx; color:#737e77; font-size:22rpx; }.agreement checkbox { transform:scale(.78); }.agreement-link { color:#068e48; }
.pay-button { height:96rpx; border:0; border-radius:26rpx; background:#07c160; color:#fff; font-size:29rpx; font-weight:700; line-height:96rpx; box-shadow:0 14rpx 30rpx rgba(7,193,96,.2); }.pay-button::after { border:0; }.pay-button[disabled] { background:#a9d8bd; color:#fff; }
.error { margin-top:24rpx; padding:22rpx; border-radius:18rpx; background:#fff5f3; color:#b34d3f; text-align:center; font-size:23rpx; }
.terms { margin-top:38rpx; color:#929b95; font-size:21rpx; line-height:1.65; text-align:center; }
