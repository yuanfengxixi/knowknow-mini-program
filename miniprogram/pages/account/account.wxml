<view class="account-shell">
  <loading-mask show="{{booting}}" bg="#FFFFFF"/>
  <top-nav activeTab="account" bindtabchange="onNavChange"/>

<view class="account-page">

  <view class="account-header">
    <view class="account-logo" bindtap="goChat" aria-role="button" aria-label="返回聊天">KNOW KNOW</view>
    <text class="account-title">个人中心</text>
  </view>

  <view class="account-card persona-card">
    <view class="persona-main">
      <view class="persona-avatar">{{overview.persona.emoji}}</view>
      <view>
        <text class="persona-label">我的知识人格</text>
        <text class="persona-name">{{overview.persona.name}}</text>
      </view>
    </view>
    <text class="persona-desc">{{overview.persona.description}}</text>
  </view>

  <view class="section-title">记忆与偏好</view>
  <view class="account-card memory-card">
    <view class="memory-entry" bindtap="openMemory" aria-role="button">
      <view class="memory-copy"><text class="memory-name">AI 了解的我</text><text class="memory-desc">查看、修改或撤销知知保存的长期记忆</text></view>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <view class="section-title">我的记录</view>
  <view class="account-card data-card">
    <view class="data-switch">
      <button class="{{activeView === 'track' ? 'on' : ''}}" data-view="track" bindtap="selectView">轨迹</button>
      <button class="{{activeView === 'content' ? 'on' : ''}}" data-view="content" bindtap="selectView">内容</button>
      <button class="{{activeView === 'time' ? 'on' : ''}}" data-view="time" bindtap="selectView">时间</button>
    </view>

    <view wx:if="{{loadError}}" class="load-error" bindtap="loadOverview">{{loadError}} · 点击重试</view>

    <view wx:elif="{{activeView === 'track'}}" class="data-view">
      <view class="data-caption">
        <view><text class="data-num">{{overview.total}}</text><text class="data-sub">条记录</text></view>
        <text class="data-right">最近 30 天</text>
      </view>
      <view class="heat-grid">
        <view wx:for="{{overview.heatmap}}" wx:key="date" class="heat-cell heat-l{{item.level}}" aria-label="{{item.date}} {{item.count}}条"></view>
      </view>
      <view class="heat-legend">少 <text class="heat-l1"></text><text class="heat-l2"></text><text class="heat-l3"></text><text class="heat-l4"></text> 多</view>
      <view class="insight">🌱 你已经连续记录 <text>{{overview.streak}}</text> 天，继续保持自己的节奏。</view>
    </view>

    <view wx:elif="{{activeView === 'content'}}" class="data-view">
      <view class="data-caption">
        <view><text class="data-num">{{overview.total}}</text><text class="data-sub">条记录</text></view>
        <text class="data-right">全部记录</text>
      </view>
      <view class="content-chart">
        <view class="donut" style="background:{{donutBackground}}"><view><text>{{overview.total}}</text><text>条记录</text></view></view>
        <view class="category-rows">
          <view class="category-row" wx:for="{{overview.categories}}" wx:key="name">
            <view class="category-name"><text class="category-dot" style="background:{{item.color}}"></text><text class="category-label">{{item.name}}</text></view>
            <text>{{item.percent}}%</text>
          </view>
        </view>
      </view>
      <view class="insight">💡 最近，你记录最多的是 <text>{{overview.topCategory}}</text>。</view>
    </view>

    <view wx:else class="data-view">
      <view class="data-caption">
        <view><text class="data-num">{{overview.peakHour}}</text><text class="data-sub">最常记录</text></view>
        <text class="data-right">24 小时分布</text>
      </view>
      <view class="time-chart">
        <view class="time-bars">
          <view wx:for="{{overview.hours}}" wx:key="hour" class="time-bar {{item.hot ? 'hot' : ''}}" style="height:{{item.height}}%" aria-label="{{item.hour}}时 {{item.count}}条"></view>
        </view>
        <view class="time-labels"><text>00</text><text>06</text><text>12</text><text>18</text><text>24</text></view>
      </view>
      <view class="time-note">{{overview.timeInsight}}</view>
    </view>
  </view>

  <view class="section-title">知知会员</view>
  <view class="account-card action-list">
    <view class="action-item" bindtap="openMembership"><view class="action-icon member-icon">知</view><view class="action-copy"><text>会员与额度</text><text>¥19.9/月 · 每期 10,000 积分</text></view><text class="action-arrow">›</text></view>
  </view>

  <view class="section-title">我的数据</view>
  <view class="account-card action-list">
    <view class="action-item" bindtap="goRecycle"><view class="action-icon">🗑</view><text>回收站</text><text class="action-arrow">›</text></view>
    <view class="action-item" bindtap="exportData"><view class="action-icon">⇧</view><text>导出我的数据</text><text class="action-arrow">›</text></view>
  </view>

  <view class="section-title">其他</view>
  <view class="account-card action-list">
    <view class="action-item" bindtap="showAccountSecurity"><view class="action-icon">🔐</view><text>账号与安全</text><text class="action-arrow">›</text></view>
    <view class="action-item" bindtap="openPrivacy"><view class="action-icon">◇</view><text>隐私设置</text><text class="action-arrow">›</text></view>
    <view class="action-item" bindtap="showAbout"><view class="action-icon">○</view><text>关于 KNOW KNOW</text><text class="action-arrow">›</text></view>
  </view>

  <view class="account-footer">KNOW KNOW · 记录你所想，留下你所知</view>
</view>
</view>
