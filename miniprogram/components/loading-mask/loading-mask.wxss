/* 全屏加载遮罩：知知原地弹跳（2026-08-20 替换「知」字牌；08-22 起冷启动/切页统一此动画） */
.lm {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1200; /* 页面内浮层最高是 library 的 1150，遮罩必须压过一切 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.lm-label { margin-top:24rpx; color:#777; font-size:28rpx; }
