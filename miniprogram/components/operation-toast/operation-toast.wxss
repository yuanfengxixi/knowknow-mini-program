:host { display: contents; }
.operation-toast {
  position: fixed;
  left: 50%;
  bottom: calc(154rpx + env(safe-area-inset-bottom));
  z-index: 1150;
  max-width: 76vw;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  background: rgba(30, 30, 32, 0.94);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.18);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.4;
  white-space: nowrap;
}
.operation-toast-spinner {
  width: 24rpx;
  height: 24rpx;
  flex: none;
  border: 3rpx solid rgba(255, 255, 255, 0.45);
  border-right-color: #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  animation: operation-toast-spin 0.7s linear infinite;
}
@keyframes operation-toast-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .operation-toast-spinner { animation: none; } }
